# Optional overrides. Uncomment only what you need; even an empty value overrides YAML.
# Keep fixed process settings in config/settings.yaml for Git review.

# MQTT
# MQTT_ENABLED=true
# MQTT_HOST=mqtt.example.internal
# MQTT_PORT=1883
# MQTT_CLIENT_ID=process-engine-app
# MQTT_USERNAME=reader
# MQTT_PASSWORD=replace-me

# OPC UA
# OPCUA_ENABLED=false
# OPCUA_ENDPOINT=opc.tcp://opcua.example.internal:4840
# OPCUA_APPLICATION_URI=urn:process-engine-app
# OPCUA_TIMEOUT_S=5
# OPCUA_RECONNECT_INTERVAL_S=30
# OPCUA_PUBLISHING_INTERVAL_MS=250
# OPCUA_SAMPLING_INTERVAL_MS=250
# OPCUA_USERNAME=reader
# OPCUA_PASSWORD=replace-me
# OPCUA_SECURITY_POLICY=Basic256Sha256
# OPCUA_SECURITY_MODE=SignAndEncrypt
# OPCUA_CERTIFICATE_PATH=/app/certs/client.der
# OPCUA_PRIVATE_KEY_PATH=/app/certs/client.pem
# OPCUA_PRIVATE_KEY_PASSWORD=replace-me
# OPCUA_SERVER_CERTIFICATE_PATH=/app/certs/server.der

# QuestDB
# QUESTDB_ENABLED=false
# QUESTDB_CLIENT_CONF=http::addr=questdb.example.internal:9000;

# Application and Compose
# API_HOST=127.0.0.1
# LOG_LEVEL=INFO
# APP_IMAGE=registry.example.com/industrial-apps/__SERVICE_NAME__:latest

# docker-build.sh reads PLATFORM from the shell, not automatically from .env.
# PLATFORM=linux/amd64
